# From Supabase: Project Settings > API. The anon key is safe to ship in a web
# app; row-level security decides what it can read. Never put the service_role
# key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# The website address, used in invite links sent from the phone apps.
VITE_SITE_URL=https://yeahnah.cookiebadboy.com
